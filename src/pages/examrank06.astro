---
// Standalone page — no Layout, no header/footer, no navigation
// Only accessible via direct link: volmer.es/examrank06
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Exam Rank 06 | Practice</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --bg-main: #1e1e1e;
            --bg-sidebar: #252526;
            --bg-titlebar: #323233;
            --bg-tab-active: #1e1e1e;
            --bg-tab-inactive: #2d2d2d;
            --bg-statusbar: #007acc;
            --bg-input: #3c3c3c;
            --text-main: #d4d4d4;
            --text-dim: #858585;
            --text-bright: #ffffff;
            --accent: #007acc;
            --accent-green: #4ec9b0;
            --accent-orange: #ce9178;
            --accent-red: #f44747;
            --accent-yellow: #dcdcaa;
            --border: #3c3c3c;
            --scrollbar-bg: #1e1e1e;
            --scrollbar-thumb: #424242;
        }

        body {
            font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace;
            background: var(--bg-main);
            color: var(--text-main);
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* Scrollbar styling */
        ::-webkit-scrollbar { width: 10px; height: 10px; }
        ::-webkit-scrollbar-track { background: var(--scrollbar-bg); }
        ::-webkit-scrollbar-thumb { background: var(--scrollbar-thumb); border-radius: 5px; }
        ::-webkit-scrollbar-thumb:hover { background: #555; }

        /* ====== TITLE BAR ====== */
        .titlebar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--bg-titlebar);
            height: 36px;
            padding: 0 16px;
            border-bottom: 1px solid #1a1a1a;
            user-select: none;
            flex-shrink: 0;
        }

        .titlebar-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .traffic-lights {
            display: flex;
            gap: 8px;
        }

        .traffic-light {
            width: 12px;
            height: 12px;
            border-radius: 50%;
        }

        .tl-red { background: #ff5f57; }
        .tl-yellow { background: #febc2e; }
        .tl-green { background: #28c840; }

        .titlebar-title {
            font-size: 12px;
            color: var(--text-dim);
            letter-spacing: 0.5px;
        }

        .timer {
            font-size: 13px;
            color: var(--accent-green);
            font-variant-numeric: tabular-nums;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .timer-icon {
            width: 14px;
            height: 14px;
            opacity: 0.8;
        }

        /* ====== TAB BAR ====== */
        .tabbar {
            display: flex;
            align-items: stretch;
            background: var(--bg-tab-inactive);
            height: 35px;
            border-bottom: 1px solid #1a1a1a;
            flex-shrink: 0;
        }

        .tab {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0 16px;
            font-size: 13px;
            color: var(--text-dim);
            border-right: 1px solid #1a1a1a;
            cursor: pointer;
            transition: all 0.15s;
            position: relative;
        }

        .tab.active {
            background: var(--bg-tab-active);
            color: var(--text-bright);
            border-top: 2px solid var(--accent);
        }

        .tab:not(.active):hover {
            background: rgba(255,255,255,0.04);
        }

        .tab-icon {
            width: 16px;
            height: 16px;
            opacity: 0.7;
        }

        /* ====== MAIN CONTENT ====== */
        .main-content {
            display: flex;
            flex: 1;
            overflow: hidden;
        }

        /* ====== SUBJECT PANEL ====== */
        .subject-panel {
            width: 420px;
            min-width: 300px;
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            flex-shrink: 0;
            transition: width 0.3s ease;
        }

        .subject-panel.collapsed {
            width: 0;
            min-width: 0;
            border-right: none;
        }

        .subject-header {
            padding: 12px 16px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--text-dim);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .subject-toggle {
            background: none;
            border: none;
            color: var(--text-dim);
            cursor: pointer;
            padding: 4px;
            border-radius: 4px;
            transition: all 0.15s;
            display: flex;
            align-items: center;
        }

        .subject-toggle:hover {
            background: rgba(255,255,255,0.1);
            color: var(--text-bright);
        }

        .subject-body {
            flex: 1;
            overflow-y: auto;
            padding: 16px;
        }

        .subject-section {
            margin-bottom: 20px;
        }

        .subject-section-title {
            font-size: 12px;
            font-weight: 700;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            user-select: none;
        }

        .subject-section-title .arrow {
            transition: transform 0.2s;
            font-size: 10px;
        }

        .subject-section-title .arrow.open {
            transform: rotate(90deg);
        }

        .subject-section-content {
            font-size: 12px;
            line-height: 1.7;
            color: var(--text-main);
        }

        .subject-section-content.collapsed-section {
            display: none;
        }

        .subject-section-content p {
            margin-bottom: 8px;
        }

        .subject-section-content ul {
            list-style: none;
            padding-left: 0;
        }

        .subject-section-content ul li {
            padding: 2px 0;
            color: var(--text-dim);
        }

        .subject-section-content ul li::before {
            content: '›';
            color: var(--accent);
            margin-right: 8px;
            font-weight: bold;
        }

        .subject-code {
            background: #1a1a1a;
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 14px;
            font-size: 11px;
            line-height: 1.6;
            overflow-x: auto;
            white-space: pre;
            color: var(--text-main);
            margin-top: 8px;
        }

        .subject-code .kw { color: #569cd6; }
        .subject-code .type { color: #4ec9b0; }
        .subject-code .str { color: #ce9178; }
        .subject-code .num { color: #b5cea8; }
        .subject-code .comment { color: #6a9955; }
        .subject-code .fn { color: #dcdcaa; }
        .subject-code .pp { color: #c586c0; }

        /* ====== EDITOR AREA ====== */
        .editor-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
        }

        #editor-container {
            flex: 1;
            overflow: hidden;
        }

        /* ====== STATUS BAR ====== */
        .statusbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--bg-statusbar);
            height: 28px;
            padding: 0 12px;
            font-size: 12px;
            color: white;
            flex-shrink: 0;
            user-select: none;
        }

        .statusbar-left, .statusbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .statusbar-item {
            display: flex;
            align-items: center;
            gap: 4px;
            opacity: 0.9;
        }

        /* ====== ACTION BUTTONS ====== */
        .action-bar {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            background: var(--bg-main);
            border-top: 1px solid var(--border);
            flex-shrink: 0;
        }

        .btn {
            padding: 6px 16px;
            border: none;
            border-radius: 4px;
            font-family: inherit;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
            letter-spacing: 0.3px;
        }

        .btn-check {
            background: #0e639c;
            color: white;
        }

        .btn-check:hover {
            background: #1177bb;
            box-shadow: 0 0 12px rgba(14, 99, 156, 0.4);
        }

        .btn-solution {
            background: transparent;
            color: var(--text-dim);
            border: 1px solid var(--border);
        }

        .btn-solution:hover {
            color: var(--text-bright);
            border-color: var(--text-dim);
        }

        .btn-reset {
            background: transparent;
            color: var(--text-dim);
            border: 1px solid var(--border);
        }

        .btn-reset:hover {
            color: var(--accent-red);
            border-color: var(--accent-red);
        }

        .btn-toggle-subject {
            background: transparent;
            color: var(--text-dim);
            border: 1px solid var(--border);
            margin-left: auto;
        }

        .btn-toggle-subject:hover {
            color: var(--text-bright);
            border-color: var(--text-dim);
        }

        /* ====== RESULTS OVERLAY ====== */
        .results-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.85);
            backdrop-filter: blur(8px);
            z-index: 1000;
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 24px;
            animation: fadeIn 0.3s ease;
        }

        .results-overlay.visible {
            display: flex;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .results-card {
            background: var(--bg-sidebar);
            border: 1px solid var(--border);
            border-radius: 12px;
            width: 100%;
            max-width: 900px;
            max-height: 85vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0,0,0,0.6);
            animation: slideUp 0.3s ease;
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .results-header {
            padding: 20px 24px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .results-title {
            font-size: 16px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .results-title.pass { color: #4ec9b0; }
        .results-title.fail { color: var(--accent-red); }

        .results-score {
            font-size: 14px;
            padding: 4px 12px;
            border-radius: 20px;
            font-weight: 700;
        }

        .results-score.pass {
            background: rgba(78, 201, 176, 0.15);
            color: #4ec9b0;
        }

        .results-score.fail {
            background: rgba(244, 71, 71, 0.15);
            color: var(--accent-red);
        }

        .results-close {
            background: none;
            border: none;
            color: var(--text-dim);
            font-size: 20px;
            cursor: pointer;
            padding: 4px 8px;
            border-radius: 4px;
            transition: all 0.15s;
        }

        .results-close:hover {
            background: rgba(255,255,255,0.1);
            color: var(--text-bright);
        }

        .results-body {
            flex: 1;
            overflow-y: auto;
            padding: 0;
        }

        .diff-container {
            font-size: 12px;
            line-height: 1.6;
        }

        .diff-line {
            display: flex;
            padding: 1px 16px;
            white-space: pre;
            font-family: 'JetBrains Mono', monospace;
        }

        .diff-line.match { background: transparent; color: var(--text-dim); }
        .diff-line.added { background: rgba(78, 201, 176, 0.08); color: #4ec9b0; }
        .diff-line.removed { background: rgba(244, 71, 71, 0.12); color: #f88; }

        .diff-line-num {
            width: 40px;
            text-align: right;
            padding-right: 12px;
            color: var(--text-dim);
            opacity: 0.5;
            flex-shrink: 0;
            user-select: none;
        }

        .diff-line-sign {
            width: 20px;
            text-align: center;
            flex-shrink: 0;
            font-weight: bold;
        }

        .diff-line.added .diff-line-sign { color: #4ec9b0; }
        .diff-line.removed .diff-line-sign { color: var(--accent-red); }

        .diff-line-content {
            flex: 1;
            overflow-x: auto;
        }

        /* ====== PASS ANIMATION ====== */
        .pass-banner {
            text-align: center;
            padding: 60px 24px;
        }

        .pass-banner .checkmark {
            width: 80px;
            height: 80px;
            background: rgba(78, 201, 176, 0.15);
            border: 3px solid #4ec9b0;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            animation: scaleIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        @keyframes scaleIn {
            from { transform: scale(0); }
            to { transform: scale(1); }
        }

        .pass-banner .checkmark svg {
            width: 40px;
            height: 40px;
            stroke: #4ec9b0;
            stroke-width: 3;
            fill: none;
            stroke-dasharray: 100;
            stroke-dashoffset: 100;
            animation: drawCheck 0.6s 0.3s forwards;
        }

        @keyframes drawCheck {
            to { stroke-dashoffset: 0; }
        }

        .pass-banner h2 {
            font-size: 28px;
            color: #4ec9b0;
            margin-bottom: 8px;
        }

        .pass-banner p {
            color: var(--text-dim);
            font-size: 14px;
        }

        /* ====== LOADING ====== */
        .loading-overlay {
            position: fixed;
            inset: 0;
            background: #0a0a0a;
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 16px;
            transition: opacity 0.5s ease;
        }

        .loading-overlay.hidden {
            opacity: 0;
            pointer-events: none;
        }

        .loading-spinner {
            width: 40px;
            height: 40px;
            border: 3px solid var(--border);
            border-top-color: var(--accent);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .loading-text {
            font-size: 13px;
            color: var(--text-dim);
        }

        /* ====== RESPONSIVE ====== */
        @media (max-width: 768px) {
            .subject-panel {
                display: none;
            }
            .btn-toggle-subject {
                display: none;
            }
        }
    </style>
</head>
<body>
    <!-- Loading -->
    <div class="loading-overlay" id="loading">
        <div class="loading-spinner"></div>
        <div class="loading-text">Cargando editor...</div>
    </div>

    <!-- Title Bar -->
    <div class="titlebar">
        <div class="titlebar-left">
            <div class="traffic-lights">
                <div class="traffic-light tl-red"></div>
                <div class="traffic-light tl-yellow"></div>
                <div class="traffic-light tl-green"></div>
            </div>
            <span class="titlebar-title">EXAM RANK 06 — mini_serv</span>
        </div>
        <div class="timer" id="timer">
            <svg class="timer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span id="timer-display">00:00:00</span>
        </div>
    </div>

    <!-- Tab Bar -->
    <div class="tabbar">
        <div class="tab active">
            <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="#519aba" stroke-width="1.5"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>
            mini_serv.c
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Subject Panel -->
        <div class="subject-panel" id="subject-panel">
            <div class="subject-header">
                <span>📋 Subject</span>
            </div>
            <div class="subject-body">
                <!-- Assignment -->
                <div class="subject-section">
                    <div class="subject-section-title" onclick="toggleSection(this)">
                        <span class="arrow open">▶</span> Assignment
                    </div>
                    <div class="subject-section-content">
                        <p style="color: var(--accent-green); font-weight: 700; font-size: 14px; margin-bottom: 12px;">mini_serv</p>
                        <p>Escribe un programa que funcione como un <strong style="color: var(--text-bright);">servidor de chat</strong> usando sockets TCP.</p>
                        <p>El servidor debe:</p>
                        <ul>
                            <li>Aceptar conexiones de múltiples clientes</li>
                            <li>Asignar un ID incremental a cada cliente</li>
                            <li>Reenviar los mensajes de cada cliente a todos los demás</li>
                            <li>Notificar cuando un cliente se conecta o desconecta</li>
                            <li>Usar <code style="color: var(--accent-orange);">select()</code> para I/O multiplexing</li>
                        </ul>
                    </div>
                </div>

                <!-- Allowed Functions -->
                <div class="subject-section">
                    <div class="subject-section-title" onclick="toggleSection(this)">
                        <span class="arrow open">▶</span> Funciones permitidas
                    </div>
                    <div class="subject-section-content">
                        <ul>
                            <li>write, close, select</li>
                            <li>socket, accept, listen, send, recv, bind</li>
                            <li>strlen, strcpy, strcat, sprintf</li>
                            <li>calloc, realloc, free, malloc</li>
                            <li>bzero, htonl, htons, atoi</li>
                            <li>exit</li>
                        </ul>
                    </div>
                </div>

                <!-- Error Messages -->
                <div class="subject-section">
                    <div class="subject-section-title" onclick="toggleSection(this)">
                        <span class="arrow open">▶</span> Mensajes requeridos
                    </div>
                    <div class="subject-section-content">
                        <p><code style="color: var(--accent-orange);">"Wrong number of arguments\n"</code> → stderr, si argc != 2</p>
                        <p><code style="color: var(--accent-orange);">"Fatal error\n"</code> → stderr, ante cualquier error fatal</p>
                        <p><code style="color: var(--accent-orange);">"server: client X just arrived\n"</code> → al conectarse</p>
                        <p><code style="color: var(--accent-orange);">"server: client X just left\n"</code> → al desconectarse</p>
                        <p><code style="color: var(--accent-orange);">"client X: "&lt;msg&gt;</code> → al reenviar mensaje</p>
                    </div>
                </div>

                <!-- Given Code: extract_message -->
                <div class="subject-section">
                    <div class="subject-section-title" style="display: flex; justify-content: space-between; align-items: center;">
                        <span onclick="toggleSection(this.parentElement)" style="cursor: pointer;"><span class="arrow open">▶</span> Código dado: extract_message</span>
                        <button class="btn" style="padding: 2px 8px; font-size: 10px; background: var(--bg-editor);" onclick="insertSnippet('extract_message')">Insertar</button>
                    </div>
                    <div class="subject-section-content">
                        <p style="font-size: 11px; color: var(--text-dim); margin-bottom: 6px;">Esta función extrae un mensaje completo terminado en '\n' del buffer de un cliente.</p>
                        <pre class="subject-code"><span class="kw">int</span> <span class="fn">extract_message</span>(<span class="type">char</span> **buf, <span class="type">char</span> **msg)
&#123;
    <span class="type">char</span> *newbuf;
    <span class="kw">int</span> i = <span class="num">0</span>;

    *msg = <span class="num">0</span>;
    <span class="kw">if</span> (!*buf)
        <span class="kw">return</span> (<span class="num">0</span>);
    <span class="kw">while</span> ((*buf)[i])
    &#123;
        <span class="kw">if</span> ((*buf)[i] == <span class="str">'\n'</span>)
        &#123;
            newbuf = <span class="fn">calloc</span>(<span class="num">1</span>, <span class="fn">strlen</span>(*buf + i + <span class="num">1</span>) + <span class="num">1</span>);
            <span class="kw">if</span> (!newbuf)
                <span class="kw">return</span> (<span class="num">-1</span>);
            <span class="fn">strcpy</span>(newbuf, *buf + i + <span class="num">1</span>);
            *msg = *buf;
            (*msg)[i + <span class="num">1</span>] = <span class="num">0</span>;
            *buf = newbuf;
            <span class="kw">return</span> (<span class="num">1</span>);
        &#125;
        i++;
    &#125;
    <span class="kw">return</span> (<span class="num">0</span>);
&#125;</pre>
                    </div>
                </div>

                <!-- Given Code: str_join -->
                <div class="subject-section">
                    <div class="subject-section-title" style="display: flex; justify-content: space-between; align-items: center;">
                        <span onclick="toggleSection(this.parentElement)" style="cursor: pointer;"><span class="arrow open">▶</span> Código dado: str_join</span>
                        <button class="btn" style="padding: 2px 8px; font-size: 10px; background: var(--bg-editor);" onclick="insertSnippet('str_join')">Insertar</button>
                    </div>
                    <div class="subject-section-content">
                        <p style="font-size: 11px; color: var(--text-dim); margin-bottom: 6px;">Concatena el buffer previo con lo recién leído.</p>
                        <pre class="subject-code"><span class="type">char</span> *<span class="fn">str_join</span>(<span class="type">char</span> *buf, <span class="type">char</span> *add)
&#123;
    <span class="type">char</span> *newbuf;
    <span class="kw">int</span> len = buf ? <span class="fn">strlen</span>(buf) : <span class="num">0</span>;

    newbuf = <span class="fn">malloc</span>(len + <span class="fn">strlen</span>(add) + <span class="num">1</span>);
    <span class="kw">if</span> (!newbuf)
        <span class="kw">return</span> (<span class="num">0</span>);
    newbuf[<span class="num">0</span>] = <span class="num">0</span>;
    <span class="kw">if</span> (buf)
        <span class="fn">strcat</span>(newbuf, buf);
    <span class="fn">free</span>(buf);
    <span class="fn">strcat</span>(newbuf, add);
    <span class="kw">return</span> (newbuf);
&#125;</pre>
                    </div>
                </div>
            </div>
        </div>

        <!-- Editor -->
        <div class="editor-area">
            <div id="editor-container"></div>
        </div>
