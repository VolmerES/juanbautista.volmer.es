    <!-- Monaco Editor Loader -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/monaco-editor@0.52.0/min/vs/loader.js"></script>

    <script is:inline>
        const SOLUTION_BASE64 = ``;
        const getSolutionCode = () => atob(SOLUTION_BASE64.replace(/\s+/g, ''));

        let editor;
        let startTime = Date.now();

        // ====== TIMER ======
        function updateTimer() {
            const elapsed = Date.now() - startTime;
            const h = String(Math.floor(elapsed / 3600000)).padStart(2, '0');
            const m = String(Math.floor((elapsed % 3600000) / 60000)).padStart(2, '0');
            const s = String(Math.floor((elapsed % 60000) / 1000)).padStart(2, '0');
            document.getElementById('timer-display').textContent = `${h}:${m}:${s}`;
        }
        setInterval(updateTimer, 1000);

        // ====== SECTION TOGGLES ======
        function toggleSection(titleEl) {
            const arrow = titleEl.querySelector('.arrow');
            const content = titleEl.nextElementSibling;
            if (content.classList.contains('collapsed-section')) {
                content.classList.remove('collapsed-section');
                arrow.classList.add('open');
            } else {
                content.classList.add('collapsed-section');
                arrow.classList.remove('open');
            }
        }

        // ====== SUBJECT PANEL TOGGLE ======
        function toggleSubjectPanel() {
            document.getElementById('subject-panel').classList.toggle('collapsed');
            if (editor) editor.layout();
        }

        // ====== MONACO EDITOR INIT ======
        require.config({
            paths: { vs: 'https://cdn.jsdelivr.net/npm/monaco-editor@0.52.0/min/vs' }
        });

        require(['vs/editor/editor.main'], function () {
            // Register custom language features to colorize fd_set, sockaddr_in, socklen_t as types
            monaco.languages.setMonarchTokensProvider('c', {
                tokenizer: {
                    root: [
                        [/\b(fd_set|sockaddr_in|socklen_t)\b/, 'type.identifier'],
                        [/^[ \t]*#include/, 'keyword.directive.include'],
                        [/\b(int|char|void|struct)\b/, 'keyword'],
                        [/\b(if|else|while|for|return|break|continue)\b/, 'keyword'],
                        [/\b(sizeof)\b/, 'keyword'],
                        [/[{}()\[\]]/, '@brackets'],
                        [/[0-9]+/, 'number'],
                        [/"([^"\\]|\\.)*$/, 'string.invalid'],
                        [/"/, 'string', '@string'],
                        [/'[^\\']'/, 'string'],
                        [/'/, 'string.invalid'],
                        [/\/\*/, 'comment', '@comment'],
                        [/\/\/.*$/, 'comment']
                    ],
                    string: [
                        [/[^\\"]+/, 'string'],
                        [/\\./, 'string.escape.invalid'],
                        [/"/, 'string', '@pop']
                    ],
                    comment: [
                        [/[^\/*]+/, 'comment'],
                        [/\*\//, 'comment', '@pop'],
                        [/[\/*]/, 'comment']
                    ]
                }
            });

            // Add custom theme rule for 'type.identifier' to make it green
            monaco.editor.defineTheme('custom-exam-dark', {
                base: 'vs-dark',
                inherit: true,
                rules: [
                    { token: 'type.identifier', foreground: '4ec9b0' },
                    { token: 'keyword.directive.include', foreground: 'c586c0' }
                ],
                colors: {}
            });

            editor = monaco.editor.create(document.getElementById('editor-container'), {
                value: '',
                language: 'c',
                theme: 'custom-exam-dark',
                fontFamily: "'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace",
                fontSize: 14,
                lineHeight: 22,
                minimap: { enabled: false },
                automaticLayout: true,
                scrollBeyondLastLine: true,
                renderLineHighlight: 'all',
                cursorBlinking: 'smooth',
                cursorSmoothCaretAnimation: 'on',
                smoothScrolling: true,
                bracketPairColorization: { enabled: true },
                guides: {
                    bracketPairs: true,
                    indentation: true,
                },
                padding: { top: 12, bottom: 12 },
                // Disable autocomplete / intellisense
                suggest: { enabled: false },
                quickSuggestions: false,
                parameterHints: { enabled: false },
                wordBasedSuggestions: 'off',
                suggestOnTriggerCharacters: false,
                acceptSuggestionOnEnter: 'off',
                tabCompletion: 'off',
                inlineSuggest: { enabled: false },
                // Keep useful features
                autoClosingBrackets: 'always',
                autoClosingQuotes: 'always',
                autoIndent: 'full',
                formatOnPaste: false,
                formatOnType: false,
            });

            // Update cursor position in status bar
            editor.onDidChangeCursorPosition(function (e) {
                document.getElementById('cursor-pos').textContent =
                    `Ln ${e.position.lineNumber}, Col ${e.position.column}`;
            });

            // Save to localStorage
            const saved = localStorage.getItem('examrank06-code');
            if (saved) {
                editor.setValue(saved);
            }

            editor.onDidChangeModelContent(function () {
                localStorage.setItem('examrank06-code', editor.getValue());
            });

            // Hide loading
            setTimeout(() => {
                document.getElementById('loading').classList.add('hidden');
                editor.focus();
            }, 500);
        });

        // ====== NORMALIZE CODE ======
        function normalizeCode(code) {
            let lines = code.split('\n');
            let cleanLines = [];
            
            let inMultiLineComment = false;

            for (let i = 0; i < lines.length; i++) {
                let originalLine = lines[i];
                let lineNum = i + 1;
                
                // Handle multi-line comments
                if (inMultiLineComment) {
                    if (originalLine.includes('*/')) {
                        inMultiLineComment = false;
                        originalLine = originalLine.split('*/')[1] || '';
                    } else {
                        continue;
                    }
                }
                if (originalLine.includes('/*')) {
                    if (originalLine.includes('*/')) {
                        originalLine = originalLine.replace(/\/\*[\s\S]*?\*\//g, '');
                    } else {
                        inMultiLineComment = true;
                        originalLine = originalLine.split('/*')[0] || '';
                    }
                }

                // Handle single-line comments
                let lineParts = originalLine.split('//');
                let line = lineParts[0];

                line = line.replace(/\t/g, '    ').trim();
                let normalizedText = line.replace(/\s+/g, ' ');
                
                if (normalizedText !== '') {
                    cleanLines.push({ text: normalizedText, lineNum: lineNum, original: lines[i] });
                }
            }

            // Group into blocks by tracking brace depth
            let blocks = [];
            let currentBlock = [];
            let braceDepth = 0;

            for (const line of cleanLines) {
                currentBlock.push(line);
                for (let j = 0; j < line.text.length; j++) {
                    if (line.text[j] === '{') braceDepth++;
                    if (line.text[j] === '}') braceDepth--;
                }
                
                // Block ends when brace depth returns to 0 and line ends appropriately
                if (braceDepth === 0 && (line.text.endsWith('}') || line.text.endsWith(';') || line.text.startsWith('#'))) {
                    blocks.push(currentBlock);
                    currentBlock = [];
                }
            }
            if (currentBlock.length > 0) blocks.push(currentBlock);

            // Sort blocks alphabetically by their first line allowing flexible function/include order
            blocks.sort((a, b) => a[0].text.localeCompare(b[0].text));

            return blocks.flat();
        }

        // ====== LCS DIFF ======
        function lcs(a, b) {
            const m = a.length, n = b.length;
            const dp = Array.from({ length: m + 1 }, () => Array(n + 1).fill(0));

            for (let i = 1; i <= m; i++) {
                for (let j = 1; j <= n; j++) {
                    if (a[i - 1].text === b[j - 1].text) {
                        dp[i][j] = dp[i - 1][j - 1] + 1;
                    } else {
                        dp[i][j] = Math.max(dp[i - 1][j], dp[i][j - 1]);
                    }
                }
            }

            // Backtrack to find diff
            const diff = [];
            let i = m, j = n;
            while (i > 0 || j > 0) {
                if (i > 0 && j > 0 && a[i - 1].text === b[j - 1].text) {
                    diff.unshift({ type: 'match', userItem: a[i - 1], solItem: b[j - 1] });
                    i--; j--;
                } else if (j > 0 && (i === 0 || dp[i][j - 1] >= dp[i - 1][j])) {
                    diff.unshift({ type: 'added', solItem: b[j - 1] });
                    j--;
                } else {
                    diff.unshift({ type: 'removed', userItem: a[i - 1] });
                    i--;
                }
            }
            return diff;
        }

        // ====== CHECK SOLUTION ======
        function checkSolution() {
            if (!editor) return;

            const userCode = editor.getValue();
            const solutionCode = getSolutionCode().trim();

            const userNorm = normalizeCode(userCode);
            const solNorm = normalizeCode(solutionCode);

            // Check if they match
            const isMatch = userNorm.length === solNorm.length &&
                userNorm.every((line, i) => line.text === solNorm[i].text);

            const overlay = document.getElementById('results-overlay');
            const titleEl = document.getElementById('results-title');
            const bodyEl = document.getElementById('results-body');

            if (isMatch) {
                // PASSED
                titleEl.className = 'results-title pass';
                titleEl.innerHTML = `
                    <span class="results-score pass">100%</span>
                    Resultado
                `;
                bodyEl.innerHTML = `
                    <div class="pass-banner">
                        <div class="checkmark">
                            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                        </div>
                        <h2>¡CORRECTO!</h2>
                        <p>Tu código coincide con la solución esperada.</p>
                    </div>
                `;
            } else {
                // FAILED - show diff
                const diff = lcs(userNorm, solNorm);
                const matchCount = diff.filter(d => d.type === 'match').length;
                const totalLines = Math.max(solNorm.length, 1);
                const score = Math.round((matchCount / totalLines) * 100);

                titleEl.className = score >= 80 ? 'results-title pass' : 'results-title fail';
                titleEl.innerHTML = `
                    <span class="results-score ${score >= 80 ? 'pass' : 'fail'}">${score}%</span>
                    Diferencias encontradas
                `;

                let diffHTML = '<div class="diff-container">';
                let lastLineNum = 0;
                diff.forEach(d => {
                    let lineStr = '';
                    let lineNumStr = '';
                    
                    if (d.type === 'match' || d.type === 'removed') {
                        lineStr = escapeHtml(d.userItem.original);
                        lineNumStr = d.userItem.lineNum;
                    } else if (d.type === 'added') {
                        lineStr = escapeHtml(d.solItem.original);
                        lineNumStr = 'Falta';
                    }

                    const sign = d.type === 'match' ? ' ' : d.type === 'added' ? '+' : '-';
                    diffHTML += `
                        <div class="diff-line ${d.type}">
                            <span class="diff-line-num">${lineNumStr}</span>
                            <span class="diff-line-sign">${sign}</span>
                            <span class="diff-line-content">${lineStr}</span>
                        </div>
                    `;
                });
                diffHTML += '</div>';
                bodyEl.innerHTML = diffHTML;
            }

            overlay.classList.add('visible');
        }

        function escapeHtml(str) {
            return str
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        // ====== SHOW SOLUTION ======
        function toggleSolutionMenu(e) {
            if (e) e.stopPropagation();
            document.getElementById('solution-menu').classList.toggle('hidden');
        }

        // Hide menu if clicked outside
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.dropdown')) {
                const menu = document.getElementById('solution-menu');
                if (menu) menu.classList.add('hidden');
            }
        });

        function showSolutionPart(part, e) {
            if (e) e.stopPropagation();
            if (!editor) return;
            document.getElementById('solution-menu').classList.add('hidden');

            const fullCode = getSolutionCode();
            
            if (part === 'all') {
                if (confirm('¿Quieres SOBRESCRIBIR tu código con la solución completa?')) {
                    editor.setValue(fullCode);
                }
                return;
            }

            let snippet = getSnippetForPart(part);

            if (snippet) {
                // Insert at cursor position instead of replacing entire file
                const position = editor.getPosition();
                editor.executeEdits("solution-insert", [{
                    range: new monaco.Range(position.lineNumber, 1, position.lineNumber, 1),
                    text: snippet + '\n'
                }]);
                editor.focus();
            }
        }

        function viewSolutionPart(part, e) {
            if (e) e.stopPropagation();
            document.getElementById('solution-menu').classList.add('hidden');

            let snippet = getSnippetForPart(part);
            if (snippet) {
                document.getElementById('view-function-title').innerText = part;
                document.getElementById('view-function-code').innerText = snippet;
                document.getElementById('view-function-overlay').classList.add('visible');
            }
        }

        // Helper to get snippets
        function getSnippetForPart(part) {
            switch(part) {
                case 'includes':
                    return `#include <unistd.h>\n#include <string.h>\n#include <stdlib.h>\n#include <stdio.h>\n#include <sys/socket.h>\n#include <netinet/in.h>\n\nint count, max_fd, ids[65536];\nchar *msgs[65536], buf_read[1001], buf_write[42];\nfd_set rfds, wfds, afds;\n`;
                case 'fatal_error':
                    return `void fatal_error(void)\n{\n\twrite(2, "Fatal error\\n", 12);\n\texit(1);\n}\n`;
                case 'notify_other':
                    return `void notify_other(int author, char *str)\n{\n\tfor (int fd = 0; fd <= max_fd; fd++)\n\t{\n\t\tif (FD_ISSET(fd, &wfds) && fd != author)\n\t\t\tsend(fd, str, strlen(str), 0);\n\t}\n}\n`;
                case 'register_client':
                    return `void register_client(int fd)\n{\n\tif (fd > max_fd)\n\t\tmax_fd = fd;\n\tids[fd] = count++;\n\tmsgs[fd] = 0;\n\tFD_SET(fd, &afds);\n\tsprintf(buf_write, "server: client %d just arrived\\n", ids[fd]);\n\tnotify_other(fd, buf_write);\n}\n`;
                case 'remove_client':
                    return `void remove_client(int fd)\n{\n\tsprintf(buf_write, "server: client %d just left\\n", ids[fd]);\n\tnotify_other(fd, buf_write);\n\tfree(msgs[fd]);\n\tFD_CLR(fd, &afds);\n\tclose(fd);\n}\n`;
                case 'send_msg':
                    return `void send_msg(int fd)\n{\n\tchar *msg;\n\n\twhile (extract_message(&msgs[fd], &msg))\n\t{\n\t\tsprintf(buf_write, "client %d: ", ids[fd]);\n\t\tnotify_other(fd, buf_write);\n\t\tnotify_other(fd, msg);\n\t\tfree(msg);\n\t}\n}\n`;
                case 'main':
                    return `int main(int ac, char **av)\n{\n\tstruct sockaddr_in serv;\n\tint sockfd, clientfd, n;\n\tsocklen_t len;\n\n\tif (ac != 2)\n\t\treturn (write(2, "Wrong number of arguments\\n", 26), 1);\n\n\tsockfd = socket(AF_INET, SOCK_STREAM, 0);\n\tif (sockfd < 0)\n\t\tfatal_error();\n\n\tmax_fd = sockfd;\n\tFD_ZERO(&afds);\n\tFD_SET(sockfd, &afds);\n\n\tbzero(&serv, sizeof(serv));\n\tserv.sin_family = AF_INET;\n\tserv.sin_addr.s_addr = htonl(2130706433);\n\tserv.sin_port = htons(atoi(av[1]));\n\n\tif (bind(sockfd, (const struct sockaddr *)&serv, sizeof(serv))\n\t\t|| listen(sockfd, SOMAXCONN))\n\t\tfatal_error();\n\n\twhile (1)\n\t{\n\t\trfds = wfds = afds;\n\n\t\tif (select(max_fd + 1, &rfds, &wfds, 0, 0) < 0)\n\t\t\tfatal_error();\n\n\t\tfor (int fd = 0; fd <= max_fd; fd++)\n\t\t{\n\t\t\tif (!FD_ISSET(fd, &rfds))\n\t\t\t\tcontinue;\n\n\t\t\tif (fd == sockfd)\n\t\t\t{\n\t\t\t\tlen = sizeof(serv);\n\t\t\t\tclientfd = accept(sockfd, (struct sockaddr *)&serv, &len);\n\t\t\t\tif (clientfd >= 0)\n\t\t\t\t{\n\t\t\t\t\tregister_client(clientfd);\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tn = recv(fd, buf_read, 1000, 0);\n\n\t\t\t\tif (n <= 0)\n\t\t\t\t{\n\t\t\t\t\tremove_client(fd);\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\n\t\t\t\tbuf_read[n] = 0;\n\n\t\t\t\tmsgs[fd] = str_join(msgs[fd], buf_read);\n\n\t\t\t\tsend_msg(fd);\n\t\t\t}\n\t\t}\n\t}\n}\n`;
                case 'all':
                    return getSolutionCode();
            }
            return '';
        }

        // ====== INSERT GIVEN SNIPPET ======
        function insertSnippet(type) {
            if (!editor) return;
            let snippet = '';
            if (type === 'extract_message') {
                snippet = `int extract_message(char **buf, char **msg)\n{\n\tchar *newbuf;\n\tint i = 0;\n\n\t*msg = 0;\n\tif (!*buf)\n\t\treturn (0);\n\twhile ((*buf)[i])\n\t{\n\t\tif ((*buf)[i] == '\\n')\n\t\t{\n\t\t\tnewbuf = calloc(1, strlen(*buf + i + 1) + 1);\n\t\t\tif (!newbuf)\n\t\t\t\treturn (-1);\n\t\t\tstrcpy(newbuf, *buf + i + 1);\n\t\t\t*msg = *buf;\n\t\t\t(*msg)[i + 1] = 0;\n\t\t\t*buf = newbuf;\n\t\t\treturn (1);\n\t\t}\n\t\ti++;\n\t}\n\treturn (0);\n}\n`;
            } else if (type === 'str_join') {
                snippet = `char *str_join(char *buf, char *add)\n{\n\tchar *newbuf;\n\tint len = buf ? strlen(buf) : 0;\n\n\tnewbuf = malloc(len + strlen(add) + 1);\n\tif (!newbuf)\n\t\treturn (0);\n\tnewbuf[0] = 0;\n\tif (buf)\n\t\tstrcat(newbuf, buf);\n\tfree(buf);\n\tstrcat(newbuf, add);\n\treturn (newbuf);\n}\n`;
            }

            if (snippet) {
                const position = editor.getPosition();
                editor.executeEdits("snippet-insert", [{
                    range: new monaco.Range(position.lineNumber, 1, position.lineNumber, 1),
                    text: snippet + '\n'
                }]);
                editor.focus();
            }
        }

        // ====== RESET ======
        function resetEditor() {
            if (!editor) return;
            if (confirm('¿Estás seguro de que quieres borrar todo el código?')) {
                editor.setValue('');
                localStorage.removeItem('examrank06-code');
                startTime = Date.now();
            }
        }

        // ====== CLOSE RESULTS ======
        function closeResults() {
            document.getElementById('results-overlay').classList.remove('visible');
        }

        function closeViewFunction() {
            document.getElementById('view-function-overlay').classList.remove('visible');
        }

        // Close results on Escape
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                closeResults();
                closeViewFunction();
            }
        });
    </script>
</body>
</html>
