---
import { getLangFromUrl, useTranslations } from '../i18n/ui';

interface Props {
    grade: string | null;
    bonus?: boolean;
}

const { grade, bonus = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

{grade ? (
    <div class="flex flex-col items-start gap-0.5 shrink-0">
        <span class="font-mono text-lg sm:text-xl font-bold text-mark leading-none -rotate-2 origin-left">
            {grade}
        </span>
        {bonus && (
            <span class="font-mono text-[10px] text-mark/70 -rotate-2 origin-left">
                {t('42.bonusNote')}
            </span>
        )}
    </div>
) : (
    <span class="font-mono text-[11px] text-pencil border border-dashed border-pencil/50 px-2 py-1 shrink-0">
        ···
    </span>
)}
