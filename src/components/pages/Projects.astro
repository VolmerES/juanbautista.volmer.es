---
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
import { personalProjects } from '../../data/cursus';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const statusStyle = {
    live: 'text-mark border-mark/40 bg-mark-soft',
    wip: 'text-pen border-pen/30 bg-pen/5',
    archived: 'text-pencil border-pencil/30 bg-transparent',
} as const;
---

<main class="max-w-5xl mx-auto px-5 sm:px-8">

    <section class="pt-14 sm:pt-20 pb-12">
        <h1 class="text-4xl sm:text-5xl font-bold mb-6">
            <span class="underline-mark">{t('projects.title')}</span>
        </h1>
        <p class="text-lg leading-relaxed max-w-2xl text-ink-soft">
            {t('projects.lead')}
        </p>
    </section>

    <section class="pb-10">
        <ul class="grid sm:grid-cols-2 gap-6">
            {personalProjects.map((project) => (
                <li class="label-box p-5 flex flex-col">
                    {project.image && (
                        <div class="mb-4 -mx-1 -mt-1 border border-rule bg-paper-deep overflow-hidden">
                            <img
                                src={project.image}
                                alt={project.title}
                                loading="lazy"
                                class="w-full h-36 object-cover object-top"
                            />
                        </div>
                    )}

                    <div class="flex items-start justify-between gap-3 mb-2">
                        <h2 class="text-lg font-bold">{project.title}</h2>
                        <span class:list={["font-mono text-[10px] uppercase tracking-wider border px-2 py-0.5 shrink-0", statusStyle[project.status]]}>
                            {t(`projects.status.${project.status}` as 'projects.status.live')}
                        </span>
                    </div>

                    <p class="text-sm text-ink-soft leading-relaxed mb-4 flex-grow">
                        {project.description[lang]}
                    </p>

                    <div class="flex items-center justify-between gap-3 pt-3 border-t border-rule">
                        <p class="font-mono text-[11px] text-pencil">{project.tech.join(' · ')}</p>
                        {project.link && (
                            <a
                                href={project.link}
                                target={project.link.startsWith('http') ? '_blank' : undefined}
                                rel={project.link.startsWith('http') ? 'noopener noreferrer' : undefined}
                                class="font-mono text-[11px] text-pen underline decoration-pen/30 underline-offset-4 hover:decoration-pen transition-colors shrink-0"
                            >
                                {t('cta.read')} →
                            </a>
                        )}
                    </div>
                </li>
            ))}
        </ul>
    </section>
</main>
