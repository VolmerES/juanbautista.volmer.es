---
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
import { cursusProjects } from '../../data/cursus';
import GradeMark from '../GradeMark.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const graded = cursusProjects.filter((p) => p.grade !== null).length;
---

<main class="max-w-5xl mx-auto px-5 sm:px-8">

    <section class="pt-14 sm:pt-20 pb-12">
        <h1 class="text-4xl sm:text-5xl font-bold mb-6">
            <span class="underline-mark">{t('42.title')}</span>
        </h1>
        <p class="text-lg leading-relaxed max-w-2xl text-ink-soft mb-8">
            {t('42.lead')}
        </p>
        <p class="font-mono text-[12px] text-pencil">
            {graded}/{cursusProjects.length} {lang === 'es' ? 'evaluados' : 'graded'}
        </p>
    </section>

    <!-- Cada proyecto con su nota al margen, como en una hoja corregida. -->
    <section class="pb-10">
        <ol class="border-t border-rule">
            {cursusProjects.map((project, index) => (
                <li class="border-b border-rule py-6 flex items-start gap-4 sm:gap-8">
                    <span class="font-mono text-[11px] text-pencil pt-1 w-6 shrink-0 tabular-nums">
                        {String(index + 1).padStart(2, '0')}
                    </span>

                    <div class="flex-1 min-w-0">
                        <h2 class="text-lg sm:text-xl font-bold mb-1.5">{project.title}</h2>
                        <p class="text-ink-soft leading-relaxed mb-3 max-w-2xl">
                            {project.description[lang]}
                        </p>
                        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                            <p class="font-mono text-[11px] text-pencil">{project.tech.join(' · ')}</p>
                            {project.repo ? (
                                <a
                                    href={project.repo}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="font-mono text-[11px] text-pen underline decoration-pen/30 underline-offset-4 hover:decoration-pen transition-colors"
                                >
                                    {t('cta.code')} ↗
                                </a>
                            ) : (
                                <span class="font-mono text-[11px] text-pencil/70">{t('42.noRepo')}</span>
                            )}
                        </div>
                    </div>

                    <GradeMark grade={project.grade} bonus={project.bonus} />
                </li>
            ))}
        </ol>
    </section>
</main>
