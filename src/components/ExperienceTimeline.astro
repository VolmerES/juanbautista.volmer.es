---
/**
 * Trayectoria animada, en la línea de «Nuestra historia» de mesetair-web pero
 * con el lenguaje del cuaderno:
 *
 * - La línea es un trazo de lápiz que se va repasando en rojo al hacer scroll,
 *   y un bolígrafo baja por ella escribiendo.
 * - Cada hito es un papel pegado con cinta que entra al llegar a pantalla, y su
 *   punto se marca con un ✓ de corrector.
 * - Los años grandes del fondo se mueven a otra velocidad (parallax).
 *
 * Primero para móvil: una columna con la línea a la izquierda. A partir de md
 * los hitos alternan a ambos lados de una línea central y el año ocupa el hueco
 * del lado contrario. Con «reducir movimiento» todo aparece quieto y entero.
 */
import { getLangFromUrl } from '../i18n/ui';
import { milestones, type MilestoneKind } from '../data/experience';

const lang = getLangFromUrl(Astro.url);

const kindLabel: Record<MilestoneKind, { es: string; en: string }> = {
    origin: { es: 'Origen', en: 'Origin' },
    study: { es: 'Formación', en: 'Education' },
    work: { es: 'Trabajo', en: 'Work' },
    project: { es: 'Proyecto', en: 'Project' },
};
const nowLabel = lang === 'es' ? 'Ahora' : 'Now';

const text = (value: string | { es: string; en: string }) => (typeof value === 'string' ? value : value[lang]);
const localHref = (href: string) => (href.startsWith('/') && lang === 'en' ? `/en${href}` : href);
---

<div class="xp" data-xp>
    <div class="xp-line" aria-hidden="true">
        <div class="xp-ink"></div>
        <svg class="xp-pen" viewBox="0 0 24 64" width="20" height="54">
            <rect x="7" y="0" width="10" height="34" rx="3" fill="var(--color-ink)" />
            <rect x="15" y="4" width="3" height="18" rx="1.5" fill="var(--color-pencil)" />
            <rect x="7" y="31" width="10" height="11" rx="1.5" fill="var(--color-pen)" />
            <path d="M7 42 H17 L12.6 60 H11.4 Z" fill="#cfd6e0" />
            <circle cx="12" cy="60.5" r="1.6" fill="var(--color-mark)" />
        </svg>
    </div>

    <ol class="xp-items">
        {milestones.map((m, i) => (
            <li class:list={['xp-item', i % 2 === 0 ? 'xp-left' : 'xp-right']} style={`--tilt: ${i % 2 === 0 ? '-0.7deg' : '0.6deg'}`} data-xp-item>
                <span class="xp-dot" aria-hidden="true">
                    <svg viewBox="0 0 20 20"><path d="M5 10.5 L8.5 14 L15 6.5" /></svg>
                </span>

                {m.backdrop && (
                    <span class="xp-backdrop" aria-hidden="true" data-xp-parallax>{text(m.backdrop)}</span>
                )}

                <article class:list={['xp-card', { 'xp-card--current': m.current }]}>
                    <span class="xp-tape" aria-hidden="true"></span>
                    {m.current && <span class="xp-stamp" aria-hidden="true">{nowLabel}</span>}

                    <p class="xp-meta">
                        <span class="xp-period">{m.period[lang]}</span>
                        <span class={`xp-kind xp-kind--${m.kind}`}>{kindLabel[m.kind][lang]}</span>
                    </p>
                    <h3 class="xp-title">{m.title[lang]}</h3>
                    {m.place && <p class="xp-place">{m.place[lang]}</p>}
                    <p class="xp-desc">{m.description[lang]}</p>

                    {(m.tags || m.link) && (
                        <div class="xp-foot">
                            {m.tags && <p class="xp-tags">{m.tags.join(' · ')}</p>}
                            {m.link && (
                                <a
                                    class="xp-link"
                                    href={localHref(m.link.href)}
                                    {...(m.link.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
                                >
                                    {m.link.label[lang]} {m.link.href.startsWith('http') ? '↗' : '→'}
                                </a>
                            )}
                        </div>
                    )}
                </article>
            </li>
        ))}
    </ol>
</div>

<style>
    /* ---------------- Móvil: una columna, línea a la izquierda ---------------- */
    .xp {
        --xp-gutter: 2.4rem;
        --xp-line-x: 0.7rem;
        --xp-progress: 0;
        --xp-pen-y: 0px;
        position: relative;
        padding: 0.5rem 0 1rem var(--xp-gutter);
    }

    .xp-line {
        position: absolute;
        top: 0;
        bottom: 0;
        left: var(--xp-line-x);
        width: 2px;
        /* Trazo de lápiz discontinuo: lo que queda por recorrer */
        background: repeating-linear-gradient(to bottom, var(--color-pencil) 0 6px, transparent 6px 11px);
        opacity: 0.9;
    }
    .xp-ink {
        position: absolute;
        inset: 0;
        background: var(--color-mark);
        border-radius: 2px;
        transform-origin: top;
        transform: scaleY(var(--xp-progress));
    }
    .xp-pen {
        position: absolute;
        left: 50%;
        top: 0;
        transform-origin: 50% 100%;
        transform: translate(-50%, calc(var(--xp-pen-y) - 100%)) rotate(14deg);
        filter: drop-shadow(0 3px 3px rgba(23, 35, 58, 0.18));
        pointer-events: none;
    }

    /* Un solo contexto de apilado para toda la lista: así cualquier tarjeta
       queda por encima de cualquier año de fondo, también del hito vecino. */
    .xp-items {
        isolation: isolate;
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 2.6rem;
    }

    .xp-item {
        position: relative;
    }

    /* El punto de la línea: un círculo de lápiz que se corrige con un ✓ rojo */
    .xp-dot {
        position: absolute;
        top: 1.15rem;
        left: calc(var(--xp-line-x) - var(--xp-gutter) + 1px);
        width: 22px;
        height: 22px;
        transform: translateX(-50%);
        border-radius: 50%;
        background: var(--color-paper);
        border: 2px solid var(--color-pencil);
        display: grid;
        place-items: center;
        z-index: 2;
        transition: border-color 0.4s ease, background-color 0.4s ease;
    }
    .xp-dot svg {
        width: 14px;
        height: 14px;
        fill: none;
        stroke: var(--color-mark);
        stroke-width: 2.6;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-dasharray: 20;
        stroke-dashoffset: 20;
        transition: stroke-dashoffset 0.5s ease 0.25s;
    }
    .xp-item.is-visible .xp-dot {
        border-color: var(--color-mark);
        background: var(--color-mark-soft);
    }
    .xp-item.is-visible .xp-dot svg {
        stroke-dashoffset: 0;
    }

    /* Año gigante de fondo, con contorno: va en parallax */
    .xp-backdrop {
        position: absolute;
        z-index: 0;
        top: -2.2rem;
        right: -0.25rem;
        font-family: var(--font-display);
        font-weight: 800;
        font-size: clamp(4.2rem, 24vw, 6.5rem);
        line-height: 1;
        letter-spacing: -0.04em;
        color: transparent;
        -webkit-text-stroke: 1.5px color-mix(in srgb, var(--color-pencil) 45%, transparent);
        user-select: none;
        pointer-events: none;
        will-change: transform;
    }

    /* El papel pegado */
    .xp-card {
        position: relative;
        z-index: 1;
        background: #fff;
        border: 1px solid var(--color-rule);
        padding: 1.25rem 1.15rem 1.1rem;
        box-shadow: 0 1px 0 var(--color-rule), 0 10px 24px -14px rgba(23, 35, 58, 0.25);
        opacity: 0;
        transform: translateY(28px) rotate(var(--tilt));
        transition: opacity 0.7s ease, transform 0.8s cubic-bezier(0.2, 0.75, 0.2, 1);
    }
    .xp-item.is-visible .xp-card {
        opacity: 1;
        transform: translateY(0) rotate(var(--tilt));
    }
    .xp-card--current {
        border-left: 3px solid var(--color-mark);
    }

    .xp-tape {
        position: absolute;
        top: -10px;
        left: 1.4rem;
        width: 74px;
        height: 20px;
        background: color-mix(in srgb, var(--color-mark-soft) 85%, white);
        border: 1px solid color-mix(in srgb, var(--color-mark) 12%, transparent);
        transform: rotate(-3deg);
        opacity: 0.95;
    }

    /* Sello «Ahora», como el de un corrector */
    .xp-stamp {
        position: absolute;
        top: 0.8rem;
        right: 0.8rem;
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--color-mark);
        border: 2px solid var(--color-mark);
        border-radius: 4px;
        padding: 2px 6px;
        transform: rotate(8deg) scale(1.6);
        opacity: 0;
        transition: transform 0.35s cubic-bezier(0.3, 1.6, 0.5, 1) 0.55s, opacity 0.2s ease 0.55s;
    }
    .xp-item.is-visible .xp-stamp {
        transform: rotate(8deg) scale(1);
        opacity: 0.9;
    }

    .xp-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.35rem 0.7rem;
        margin: 0 4.5rem 0.55rem 0;
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }
    .xp-period {
        color: var(--color-mark);
        font-weight: 700;
    }
    .xp-kind {
        padding: 1px 7px;
        border-radius: 999px;
        border: 1px solid currentColor;
        font-size: 10px;
    }
    .xp-kind--work { color: var(--color-mark); }
    .xp-kind--study { color: var(--color-pen); }
    .xp-kind--project { color: #2f855a; }
    .xp-kind--origin { color: var(--color-pencil); }

    .xp-title {
        font-size: 1.2rem;
        font-weight: 700;
        margin: 0 0 0.2rem;
    }
    .xp-place {
        margin: 0 0 0.55rem;
        font-size: 0.92rem;
        color: var(--color-ink-soft);
        font-style: italic;
    }
    .xp-desc {
        margin: 0;
        color: var(--color-ink-soft);
        font-size: 0.97rem;
        line-height: 1.6;
    }
    .xp-foot {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem 1rem;
        margin-top: 0.85rem;
        padding-top: 0.7rem;
        border-top: 1px dashed var(--color-rule);
    }
    .xp-tags {
        margin: 0;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--color-pencil);
    }
    .xp-link {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--color-pen);
        text-decoration: underline;
        text-decoration-color: color-mix(in srgb, var(--color-pen) 30%, transparent);
        text-underline-offset: 4px;
        /* Zona táctil cómoda en móvil */
        padding: 0.35rem 0;
    }
    .xp-link:hover {
        text-decoration-color: var(--color-pen);
    }

    /* ---------------- md+: línea central y hitos alternos ---------------- */
    @media (min-width: 768px) {
        .xp {
            --xp-gutter: 0px;
            --xp-line-x: 50%;
            padding: 1rem 0 2rem;
        }
        .xp-line {
            transform: translateX(-1px);
        }
        .xp-items {
            gap: 1.5rem;
        }
        .xp-item {
            width: 50%;
        }
        .xp-left {
            padding-right: 3.2rem;
        }
        .xp-right {
            margin-left: 50%;
            padding-left: 3.2rem;
        }

        .xp-left .xp-dot {
            left: auto;
            right: 0;
            transform: translateX(50%);
        }
        .xp-right .xp-dot {
            left: 0;
            transform: translateX(-50%);
        }

        /* El año va en el hueco del otro lado de la línea */
        .xp-backdrop {
            top: 50%;
            right: auto;
            margin-top: -0.55em;
            font-size: clamp(5rem, 9vw, 8.5rem);
        }
        .xp-left .xp-backdrop {
            left: calc(100% + 3.2rem);
        }
        .xp-right .xp-backdrop {
            right: calc(100% + 3.2rem);
        }

        .xp-left .xp-card {
            transform: translateX(-46px) rotate(var(--tilt));
        }
        .xp-right .xp-card {
            transform: translateX(46px) rotate(var(--tilt));
        }
        .xp-item.is-visible .xp-card {
            transform: translateX(0) rotate(var(--tilt));
        }
        .xp-card {
            padding: 1.5rem 1.6rem 1.3rem;
        }
        .xp-title {
            font-size: 1.3rem;
        }
    }

    /* ---------------- Sin animaciones si se pide ---------------- */
    @media (prefers-reduced-motion: reduce) {
        .xp-card,
        .xp-stamp,
        .xp-dot,
        .xp-dot svg {
            transition: none;
        }
        .xp-pen {
            display: none;
        }
    }
</style>

<script>
    const root = document.querySelector<HTMLElement>('[data-xp]');

    if (root) {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const items = root.querySelectorAll<HTMLElement>('[data-xp-item]');
        const backdrops = root.querySelectorAll<HTMLElement>('[data-xp-parallax]');

        if (reduceMotion || !('IntersectionObserver' in window)) {
            items.forEach((item) => item.classList.add('is-visible'));
            root.style.setProperty('--xp-progress', '1');
        } else {
            // Cada hito entra una sola vez, cuando asoma por abajo.
            const observer = new IntersectionObserver(
                (entries) => {
                    for (const entry of entries) {
                        if (!entry.isIntersecting) continue;
                        entry.target.classList.add('is-visible');
                        observer.unobserve(entry.target);
                    }
                },
                { rootMargin: '0px 0px -12% 0px', threshold: 0.12 },
            );
            items.forEach((item) => observer.observe(item));

            // Tinta, bolígrafo y parallax: una lectura de layout por frame como mucho.
            let ticking = false;
            const update = () => {
                ticking = false;
                const vh = window.innerHeight;
                const rect = root.getBoundingClientRect();
                // La tinta llega hasta la altura del 60 % de la pantalla.
                const progress = Math.min(1, Math.max(0, (vh * 0.6 - rect.top) / rect.height));
                root.style.setProperty('--xp-progress', progress.toFixed(4));
                root.style.setProperty('--xp-pen-y', `${(progress * rect.height).toFixed(1)}px`);

                // Menos recorrido en móvil, donde el año va detrás del papel.
                const factor = window.innerWidth < 768 ? 0.1 : 0.18;
                const limit = window.innerWidth < 768 ? 40 : 90;
                backdrops.forEach((el) => {
                    const box = el.parentElement!.getBoundingClientRect();
                    if (box.bottom < -200 || box.top > vh + 200) return;
                    const raw = (box.top + box.height / 2 - vh / 2) * -factor;
                    const offset = Math.max(-limit, Math.min(limit, raw));
                    el.style.transform = `translate3d(0, ${offset.toFixed(1)}px, 0)`;
                });
            };
            const onScroll = () => {
                if (ticking) return;
                ticking = true;
                window.requestAnimationFrame(update);
            };
            window.addEventListener('scroll', onScroll, { passive: true });
            window.addEventListener('resize', onScroll, { passive: true });
            update();
        }
    }
</script>
