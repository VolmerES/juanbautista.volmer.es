---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, getAlternateUrl } from '../i18n/ui';

interface Props {
    title: string;
    description?: string;
    noindex?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const { title, description, noindex = false } = Astro.props;

const defaultDescription = lang === 'es'
    ? 'El cuaderno de Juan Bautista Delorme Pinedo, desarrollador de software formado en 42 Madrid: proyectos en C y C++, apps propias y notas sobre lo que voy aprendiendo.'
    : "The notebook of Juan Bautista Delorme Pinedo, a software developer trained at 42 Madrid: C and C++ projects, personal apps and notes on what I'm learning.";

// Sale de `site` en astro.config.mjs, para que el dominio esté en un solo sitio.
const site = Astro.site!.origin;
const pathname = Astro.url.pathname;
const canonical = site + pathname;
const alternatePath = getAlternateUrl(pathname, lang);
const esURL = site + (lang === 'es' ? pathname : alternatePath);
const enURL = site + (lang === 'en' ? pathname : alternatePath);
const desc = description || defaultDescription;
---

<!doctype html>
<html lang={lang}>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="alternate" hreflang="es" href={esURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="x-default" href={esURL} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Source+Sans+3:ital,wght@0,400;0,600;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap"
        rel="stylesheet"
    />
</head>
<body class="min-h-screen flex flex-col">
    <Header />
    <div class="flex-grow">
        <slot />
    </div>
    <Footer />
</body>
</html>
